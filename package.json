{
  "name": "exoclim-3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ExoClim-3 — Worldbuilding Pasta 準拠の惑星気候設計ツール(第 3 世代)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
